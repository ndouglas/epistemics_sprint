 "type": "grad-school",
 "codes": [
  {
   "label": "Net financial cost and runway",
   "definition": "The total cost of the program after any aid, set against income and savings, and whether the person can absorb it (including lost or reduced income during study) without debt strain."
  },
  {
   "label": "Funding source and debt exposure",
   "definition": "How the program will be paid for (savings, loans, employer aid, scholarships) and the resulting debt burden, emergency reserves and fallback."
  },
  {
   "label": "Employer reimbursement or support terms",
   "definition": "Whether employer tuition aid, schedule flexibility, or a post-degree role is offered, and whether it is guaranteed, conditional, or at risk of clawback or policy change."
  },
  {
   "label": "Career and income payoff",
   "definition": "Whether the credential meaningfully raises earnings or opens a better role, the size of the pay gap, and how long it takes to recoup the cost."
  },
  {
   "label": "Realizability of the payoff",
   "definition": "Whether the projected salary or role is actually attainable given local job availability, the field, employer type, and the person's ability to land the position."
  },
  {
   "label": "Career horizon and life stage",
   "definition": "The person's age and remaining working years, which determine how long the higher earnings can compound and what life events overlap the program."
  },
  {
   "label": "Time and energy capacity",
   "definition": "How many hours per week the person can realistically give to study (and clinicals) on top of their job and other obligations, and the strain this puts on sleep and personal time."
  },
  {
   "label": "Health and burnout risk",
   "definition": "The physical and emotional sustainability of combining work, school and family demands, including current job fatigue."
  },
  {
   "label": "Program length and format",
   "definition": "The duration, structure and flexibility of the program (evening part-time, online, clinical placement requirements) and whether it fits the person's schedule."
  },
  {
   "label": "Dependents' needs and childcare",
   "definition": "The ages and current needs of children and whether supervision and household stability can be maintained during the program."
  },
  {
   "label": "Support network",
   "definition": "Whether family, a co-parent, friends or paid care are available to cover caregiving and emergencies during study time."
  },
  {
   "label": "Partner's role and shared finances",
   "definition": "The partner's income, stability, priorities, risk tolerance and agreement, since the decision affects a shared household and plans."
  },
  {
   "label": "Timing relative to the wedding deposit and savings",
   "definition": "The fixed near-term deposit deadline and the competing claim on the same savings, plus the overlap of the program with the wedding and early marriage."
  },
  {
   "label": "Reversibility and alternatives",
   "definition": "Whether the person can defer, pause, withdraw or switch to a cheaper, shorter or later option without heavy loss, and what other paths exist."
  },
  {
   "label": "Current job security and satisfaction",
   "definition": "The stability of the person's present role and how fulfilling or sustainable it is, which affects both risk and the pull toward change."
  },
  {
   "label": "Motivation and role fit",
   "definition": "Whether the person genuinely wants the new role or credential and its scope of work for its own sake, versus pursuing it as an expected next step."
  },
  {
   "label": "Program quality and credential risk",
   "definition": "Whether the program's accreditation, placement support and licensing outcomes will actually deliver the credential."
  }
 ],
