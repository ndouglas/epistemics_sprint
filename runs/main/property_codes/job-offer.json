 "type": "job-offer",
 "codes": [
  {
   "label": "Compensation gap",
   "definition": "The size of the difference between the offered pay and current pay, in dollars and percent, and how it compares to total compensation including benefits."
  },
  {
   "label": "Income stability and cash flow",
   "definition": "How certain and predictable current income is versus the offer, including how much of the offer is guaranteed cash versus contingent."
  },
  {
   "label": "Equity value and risk",
   "definition": "How much any offered stock or equity is likely to be worth, given illiquidity, unknown terms, and the chance it ends up worthless."
  },
  {
   "label": "Employer stability and runway",
   "definition": "The financial health, survival odds, and job security of the new employer compared with the established current employer."
  },
  {
   "label": "Promotion prospects at current job",
   "definition": "Whether and when the current employer might promote the person, and how credible or vague the signals of advancement are."
  },
  {
   "label": "Pension vesting timing",
   "definition": "How close the person is to vesting in a pension and what leaving before that point would forfeit or delay."
  },
  {
   "label": "Benefits and retirement coverage",
   "definition": "The health insurance, retirement matching, and other non-salary benefits at each employer."
  },
  {
   "label": "Debt burden and financial cushion",
   "definition": "The size of outstanding debt, repayment terms, savings, and monthly cash flow pressure, and the buffer available if the move goes badly."
  },
  {
   "label": "Remote work and location flexibility",
   "definition": "Whether the new role offers remote work and autonomy over location and schedule compared with the current on-site or hybrid arrangement."
  },
  {
   "label": "Commute and relocation feasibility",
   "definition": "The distance of the new role and whether taking it would require a move or a long daily commute."
  },
  {
   "label": "Spouse's employment",
   "definition": "Whether a partner's job is tied to the current area, and how a move would affect her career and household income."
  },
  {
   "label": "Children's life stage",
   "definition": "The age and school stage of the person's children and how a move would affect their remaining time at home or in school."
  },
  {
   "label": "Decision deadline and due diligence",
   "definition": "How long the person has to decide and how much that limits research, negotiation, and consultation before committing."
  },
  {
   "label": "Career trajectory and skill growth",
   "definition": "How the new role changes the person's career ceiling, advancement path, and skill development, including fit with the current field."
  },
  {
   "label": "Career stage and time horizon",
   "definition": "The person's age and remaining years of work, which determine how much room there is to recover from a bad bet versus how late-career the move is."
  },
  {
   "label": "Negotiating leverage with current employer",
   "definition": "Whether the current employer might counteroffer, retain the person, or restructure the role in response to an outside offer."
  },
  {
   "label": "Role risk and fit at the new employer",
   "definition": "The uncertainty of succeeding in the new role, culture, and organization, including how easily the person could recover if it is a poor fit."
  },
  {
   "label": "Risk tolerance and personal obligations",
   "definition": "How much capacity the person has to absorb a failed bet, given dependents and other responsibilities."
  }
 ],
