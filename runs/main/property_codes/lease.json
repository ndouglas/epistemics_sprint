 "codes": [
  {
   "label": "Housing cost relative to income",
   "definition": "How large the rent or housing cost is as a share of the person's or household's income, and whether the budget can absorb it."
  },
  {
   "label": "Monthly cost difference between options",
   "definition": "The size of the monthly (and annualized) rent gap between the competing housing options."
  },
  {
   "label": "Lease length and commitment",
   "definition": "How long the person is locked into each option (fixed term, multi-year, or month-to-month) and how much flexibility they keep to leave or change plans."
  },
  {
   "label": "Decision deadline and time pressure",
   "definition": "How soon the decision must be made and how little time that leaves to compare options, research, or negotiate."
  },
  {
   "label": "Cash reserve and liquidity",
   "definition": "How much savings remain after deposits, first month's rent, and move-in costs, and whether they cover the gap before income arrives."
  },
  {
   "label": "Income stability and runway",
   "definition": "How secure and well-timed the income is, including a new or uncertain job and the gap before the first paycheck, relative to housing costs."
  },
  {
   "label": "Commute and transport dependence",
   "definition": "The travel time, mode, and daily burden of getting to work or other routines from each option, especially with no car."
  },
  {
   "label": "School district and schooling continuity",
   "definition": "Whether the children stay in their current schools and district or must change, with the social and academic disruption that implies."
  },
  {
   "label": "Childcare and family support proximity",
   "definition": "How close each option is to relatives who provide childcare or support, and how much the daily arrangement depends on that closeness."
  },
  {
   "label": "Landlord flexibility and negotiating room",
   "definition": "Whether the landlord's rent increase, terms, or deposit demand can be negotiated or adjusted."
  },
  {
   "label": "Living arrangement, privacy, and social fit",
   "definition": "The quality-of-life tradeoff between living alone and sharing a home, including privacy, social connection, and support in an unfamiliar place."
  },
  {
   "label": "Moving disruption and transition costs",
   "definition": "The time, money, effort, and relational disruption of relocating versus staying put."
  },
  {
   "label": "Scope and purpose of the decision",
   "definition": "How much of daily life the choice touches beyond a single rent number, and what the person is actually trying to achieve by staying or moving."
  }
 ],
