{
 "type": "partner-move",
 "codes": [
  {
   "label": "Relationship commitment level",
   "definition": "How formal and settled the couple's commitment is (marital status, engagement, length of time together), and whether the move tests the relationship or is part of an established shared plan."
  },
  {
   "label": "Family proximity and support network",
   "definition": "Whether extended family, friends and other support sit close to the current home, and whether comparable support would exist at the destination."
  },
  {
   "label": "Career portability, tenure and licensure",
   "definition": "How easily the person's job, license and accumulated seniority or tenure can transfer to a new location, including coursework or costs needed to requalify."
  },
  {
   "label": "Remote work flexibility",
   "definition": "Whether the person's job can be done from the new location without loss of income or standing."
  },
  {
   "label": "Financial gap and household income impact",
   "definition": "How the offered job's pay change, one partner's income concentration, and any income lost during transition alter the household's financial picture."
  },
  {
   "label": "Cost of relocation, cost of living and financial cushion",
   "definition": "The one-time costs of moving, the housing and living-cost difference between locations, and the household's financial reserves to absorb them."
  },
  {
   "label": "Reversibility of the move",
   "definition": "How realistic and costly it would be to return to the former job, home or region if the move does not work out."
  },
  {
   "label": "Decision timeline",
   "definition": "The length of the response window, time pressure, and room to extend, negotiate or gather information before deciding."
  },
  {
   "label": "Whose career is prioritized and distribution of sacrifice",
   "definition": "Which partner's career gains and which partner bears the professional and personal costs, including who initiated the move and whether the decision is mutual and equal or one-sided."
  },
  {
   "label": "Partner's career trajectory and role quality",
   "definition": "The advancement, stability, terms, and long-term value of the partner's offered position, and the consequences of declining it."
  },
  {
   "label": "Own career aspirations and sense of purpose",
   "definition": "The person's own professional identity, fulfillment, and meaning in their current work and community."
  },
  {
   "label": "Own preferences about the destination",
   "definition": "Whether the person actually wants to live in the new place and is willing to relocate, apart from the partner's wishes."
  },
  {
   "label": "Children's school and social stability",
   "definition": "The ages, school stage, social ties, and adjustment capacity of younger children, and the timing of a move relative to the school year."
  },
  {
   "label": "Custody arrangement with the teenage son",
   "definition": "Whether a shared every-other-week custody schedule with a nearby co-parent can be maintained or adapted across a long distance."
  },
  {
   "label": "Geographic distance",
   "definition": "How far the destination is, and how that distance affects ease and cost of visits, emergencies, and ongoing contact."
  },
  {
   "label": "Availability of services and opportunities at the destination",
   "definition": "Whether the new location offers comparable schools, healthcare, childcare, and career opportunities for the person."
  },
  {
   "label": "Partner's reliability and commitment at the destination",
   "definition": "How secure the partner's new job is and how firmly the partner is committed to the person, including whether he would stay or relocate for her."
  },
  {
   "label": "Age and career stage",
   "definition": "The person's age and where they stand in their career, affecting how costly it is to disrupt or restart."
  }
 ],
