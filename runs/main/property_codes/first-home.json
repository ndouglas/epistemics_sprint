 "type": "first-home",
 "codes": [
  {
   "label": "Time horizon in the home",
   "definition": "How long the person expects to stay in the purchased home, including whether that is long enough to recover transaction costs and whether the home fits their needs over the coming years."
  },
  {
   "label": "Income and job stability",
   "definition": "How secure and reliable the household's income is over the relevant period, including layoff risk, dependence on a current employer or location, and a single earner's exposure."
  },
  {
   "label": "Timing of a planned child",
   "definition": "Whether and when a child is expected, and how that changes household size, expenses, income and the demands on the mortgage commitment."
  },
  {
   "label": "Roof and property condition",
   "definition": "The condition of the property, especially the roof or other near-term repairs, and the cost and timing of that work as a hidden or unbudgeted expense."
  },
  {
   "label": "Cash reserves after purchase",
   "definition": "How much liquid savings remain after the down payment and closing costs, and whether that buffer is enough for emergencies, repairs and life changes."
  },
  {
   "label": "Monthly carrying cost versus current rent",
   "definition": "The total monthly cost of owning (payment, fees, taxes, maintenance, interest) compared with the current rent, including the size of the gap and the burden on income."
  },
  {
   "label": "Rent-versus-buy tradeoff",
   "definition": "Whether owning or continuing to rent better serves the person, including equity building, local rent and price trends, cost control versus a landlord, and market risk."
  },
  {
   "label": "Reversibility and flexibility",
   "definition": "How easily the commitment can be undone, and how much flexibility is kept by renting versus tying savings up in real estate."
  },
  {
   "label": "Housing cost stability",
   "definition": "Whether housing costs stay predictable and controllable over time, such as fixed rent versus fees or interest that may rise, including into retirement."
  },
  {
   "label": "Price relative to approval and affordability",
   "definition": "How the purchase price and loan size compare with the pre-approval ceiling, the interest rate, and what the buyer can comfortably afford from savings and income."
  },
  {
   "label": "Offer deadline and negotiating position",
   "definition": "The time pressure from the seller's review date, how real that pressure is, and how much leverage or room exists in the offer terms."
  },
  {
   "label": "Location and proximity to family",
   "definition": "Whether the person stays in their current community and job or relocates, in particular closer to a family member who lives far away, and how near-term or distant that move is."
  },
  {
   "label": "Retirement timing and financial runway",
   "definition": "When the person plans to stop working, how many earning years remain, and whether savings, salary and retirement income can sustain the purchase and its ongoing costs through retirement."
  },
  {
   "label": "Health, aging and support needs",
   "definition": "The person's expected independence versus need for care or family support in later life, and who would provide it."
  },
  {
   "label": "Liquidity of savings committed",
   "definition": "How much of total savings is tied up in the down payment and closing costs versus kept liquid for other needs."
  },
  {
   "label": "Personal and marital financial context",
   "definition": "The person's family and financial circumstances, such as divorce-related finances, being a sole earner, and the presence or absence of shared obligations or social support."
  },
  {
   "label": "Motivation and purpose",
   "definition": "What the person is actually trying to achieve and where the pressure to act comes from, such as stability, financial security, family closeness, or a default belief that owning is responsible."
  },
  {
   "label": "Complexity of interacting factors",
   "definition": "How many major financial and life variables must hold together at once for the decision to work."
  }
 ],
