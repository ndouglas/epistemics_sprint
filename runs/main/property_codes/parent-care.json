{
 "type": "parent-care",
 "codes": [
  {
   "label": "Duration of care need",
   "definition": "How long the care recipient will need help and how certain or uncertain that timeline is."
  },
  {
   "label": "Recovery or condition trajectory",
   "definition": "Whether the care recipient's condition (stroke recovery or dementia) is likely to stabilize, improve, or progress, and how fast, which changes future care intensity."
  },
  {
   "label": "Financial runway of the care recipient",
   "definition": "How long the care recipient's own savings or resources can fund the paid option, and what happens when they run out."
  },
  {
   "label": "Caregiver's income and job security",
   "definition": "The caregiver's employment stability, ability to take leave or work flexibly, and the income and career cost of reducing work."
  },
  {
   "label": "Caregiver's capacity and time",
   "definition": "The caregiver's realistic availability, energy, and existing commitments (full-time job, travelling spouse) for hands-on care."
  },
  {
   "label": "Caregiver's own well-being and burnout risk",
   "definition": "The effect of providing care on the caregiver's health, sustainability, and risk of exhaustion."
  },
  {
   "label": "Caregiver's personal life and relationships",
   "definition": "The impact on the caregiver's romantic, social, and life-stage goals and autonomy, and on commitments outside the care role."
  },
  {
   "label": "Household and marriage impact",
   "definition": "How having the care recipient in the home affects the caregiver's spouse, shared space, privacy, and household dynamics."
  },
  {
   "label": "Care recipient's preferences and autonomy",
   "definition": "What the care recipient wants about where and how they live and receive care, their dignity and sense of home, and their capacity to take part in the decision."
  },
  {
   "label": "Care recipient's cognitive and emotional state",
   "definition": "The care recipient's mental condition and capacity (dementia, post-stroke state) that shapes their decision-making and acceptance of help."
  },
  {
   "label": "Relationship and history with the care recipient",
   "definition": "The quality of the relationship, family history, and sense of obligation or attachment (including to the family home) between caregiver and care recipient."
  },
  {
   "label": "Sibling and extended family support",
   "definition": "Whether siblings, relatives, or other family can contribute, and whether their support is practical or only emotional."
  },
  {
   "label": "Availability and quality of local aides and services",
   "definition": "Whether reliable in-home aides, facilities, and medical or community services exist near the care recipient or caregiver, and how good they are."
  },
  {
   "label": "Distance, access, and emergency response",
   "definition": "The physical distance between caregiver and care recipient and how quickly help can respond when something goes wrong."
  },
  {
   "label": "Physical safety and fall risk",
   "definition": "The risk of falls or injury given the care recipient's history and living situation, especially when alone."
  },
  {
   "label": "Reversibility and hybrid options",
   "definition": "How easily a choice can be undone or adjusted later, and whether a combined or phased arrangement is available."
  },
  {
   "label": "Quality of care and supervision",
   "definition": "The level of professional skill, trusted presence, and daily supervision each option provides, including dementia-specific capability."
  },
  {
   "label": "Distribution of daily caregiving load",
   "definition": "Who would actually carry the day-to-day care under each option and whether the costs are shared or fall on one person."
  },
  {
   "label": "Visibility of the care recipient's needs",
   "definition": "Whether the caregiver can see the care recipient's condition and risks directly day to day or only through reports."
  },
  {
   "label": "Fit of caregiver's skills",
   "definition": "Whether the caregiver's professional skills suit the care needs, such as a physical therapist helping with rehabilitation."
  },
  {
   "label": "Caregiver's own finances",
   "definition": "The caregiver's personal savings and financial ability to absorb costs or lost income."
  }
 ],
