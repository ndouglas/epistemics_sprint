{
 "type": "go-freelance",
 "codes": [
  {
   "label": "Income stability and replacement",
   "definition": "Whether a steady salary can be replaced by variable or time-limited independent income, and how the new income compares with the current compensation after taxes and overhead."
  },
  {
   "label": "Contract durability and reliability",
   "definition": "Whether the offered contract or expected work is firm, how long it lasts, and whether it converts into ongoing work or ends with no follow-on."
  },
  {
   "label": "Client or customer concentration",
   "definition": "How heavily future income would depend on a single client or a few relationships rather than a diversified base."
  },
  {
   "label": "Customer commitment strength",
   "definition": "Whether the clients or customers who say they will follow are firmly committed or only expressing verbal, untested intentions."
  },
  {
   "label": "Existing independent income base",
   "definition": "Whether current side or freelance income exists, is stable, and is transferable enough to serve as a floor under an independent plan."
  },
  {
   "label": "Financial runway",
   "definition": "How many months of expenses savings and reserves can cover during income gaps, slow ramp-up, late payments, or a bad first year."
  },
  {
   "label": "Startup capital",
   "definition": "The amount of money needed to launch independently, where it comes from (savings or debt), and how much it depletes reserves."
  },
  {
   "label": "Health insurance continuity and cost",
   "definition": "Whether employer-provided health coverage must be replaced if leaving, and what the replacement costs or risks do to the budget."
  },
  {
   "label": "Employer rule or contractual restriction",
   "definition": "Whether the current employer's moonlighting, non-compete, or solicitation rules apply to the plan and could make it a violation with consequences."
  },
  {
   "label": "Employer relationship and exit terms",
   "definition": "The state of the relationship with the current employer and how it would respond to a departure or to taking the work."
  },
  {
   "label": "Reversibility and return path",
   "definition": "Whether the person could return to comparable employment, seniority, or pay if independence fails, and how costly a wrong move would be."
  },
  {
   "label": "Career trajectory and goals",
   "definition": "How staying employed versus going independent affects promotion path, reputation, skill-building, autonomy, and long-term career aims."
  },
  {
   "label": "Life stage and dependents",
   "definition": "The person's age, remaining working years, and family obligations, which determine how much risk can be absorbed and who bears it."
  },
  {
   "label": "Timing of major family expenses",
   "definition": "Whether a large known expense such as a child's college tuition coincides with the period when new independent income is least reliable."
  },
  {
   "label": "Household income and spouse's role",
   "definition": "The stability and flexibility of a partner's income and capacity to contribute more, which cushions or shares the household risk."
  },
  {
   "label": "Business skills and legal requirements",
   "definition": "Whether the person has the non-technical skills (pricing, billing, marketing, bookkeeping) and the licenses, insurance, and legal setup needed to run an independent business."
  },
  {
   "label": "Market demand and pricing",
   "definition": "Whether local demand, competition, seasonality, and achievable rates support a viable independent practice."
  },
  {
   "label": "Tax and overhead burden",
   "definition": "The self-employment taxes, equipment, software, benefits costs, and unpaid administrative time that reduce take-home pay compared with salary."
  },
  {
   "label": "Personal risk tolerance and family alignment",
   "definition": "How comfortable the person and household are with uncertainty, and whether the decision is shared and supported."
  },
  {
   "label": "Risk of inability to work",
   "definition": "Exposure to injury or illness stopping the person's only source of earnings when self-employed."
  }
 ],
