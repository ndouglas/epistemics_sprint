{
 "type": "family-loan",
 "codes": [
  {
   "label": "Lender's financial cushion",
   "definition": "How large the lender's savings, income, and reserves are relative to the loan, and whether they can absorb the outlay or a total loss without harm."
  },
  {
   "label": "Size of loan relative to savings/income",
   "definition": "The loan amount as a share of the lender's savings, down payment fund, or annual income."
  },
  {
   "label": "Lender's income stability and capacity to recover",
   "definition": "How secure and fixed or growing the lender's income is, and thus whether they can rebuild savings or must live on a thin fixed margin."
  },
  {
   "label": "Lender's own future needs and goals",
   "definition": "The lender's competing needs for the money, such as retirement security, health and long-term care costs, or a house purchase and its timeline."
  },
  {
   "label": "Repayment likelihood and track record",
   "definition": "Whether the borrower can realistically repay, based on past repayment history, current income and circumstances, and whether this is the first request."
  },
  {
   "label": "Loan versus gift framing and terms",
   "definition": "Whether the money is treated as a gift or a loan, and whether there is a written agreement, repayment schedule, or only an informal understanding."
  },
  {
   "label": "Cause and nature of the borrower's need",
   "definition": "What produced the need, such as business failure, personal spending, or divorce, and whether the money covers a sunk past loss or secures something going forward."
  },
  {
   "label": "One-time crisis versus recurring pattern",
   "definition": "Whether the request is an isolated rescue or likely the start of repeated requests, and the precedent it sets."
  },
  {
   "label": "Alternatives to lending the full amount",
   "definition": "Other ways to help or for the borrower to solve the problem, such as a smaller sum, direct bill payment, other lenders, counseling, legal aid, or non-cash support."
  },
  {
   "label": "Stakes for dependents affected",
   "definition": "Whether third parties such as the grandchildren would bear the cost of a loss, such as losing their home, and whether the money actually secures that outcome."
  },
  {
   "label": "Consequences of refusing",
   "definition": "What happens to the borrower and the relationship if the lender says no."
  },
  {
   "label": "Relationship and emotional stakes",
   "definition": "The family bond with the borrower, strain if repayment fails, and the lender's emotional commitment versus self-protection."
  },
  {
   "label": "Other family members' views and dynamics",
   "definition": "The stance of other relatives, including a sibling's private objection or parents' silence, and whether they have information, would support or resent the decision, or leave the lender without guidance."
  },
  {
   "label": "Lender's own values and autonomy",
   "definition": "The lender's personal preferences, priorities, and right to decide about their own money and goals."
  },
  {
   "label": "Source and reliability of advice",
   "definition": "Where the opinions the lender is receiving come from and how much weight and trust they deserve."
  },
  {
   "label": "Reversibility and liquidity of the commitment",
   "definition": "How accessible the lender's funds are and whether the money can be recovered once disbursed."
  }
 ],
